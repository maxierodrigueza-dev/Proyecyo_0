import datetime
import sys


with open("estado_tiempo20260910.txt", encoding="latin-1") as f:

    # Dicc principal
    mi_dicc = {}

# Datetime necesita ints, no string que digan "febrero"
    meses = {
    "enero": 1,
    "febrero": 2,
    "marzo": 3,
    "abril": 4,
    "mayo": 5,
    "junio": 6,
    "julio": 7,
    "agosto": 8,
    "septiembre": 9,
    "octubre": 10,
    "noviembre": 11,
    "diciembre": 12,
}

    for x in f:

        #Limpiamos la linea completa antes de parsear
        algo = x.strip(" / \n")
        campos = algo.split(";")

        #Dejamos pasar solo las que tienen 
        if len(campos) != 10:
            continue

        # Limpiar los espacios en blancos de ciudad
        ciuad_estación = campos[0].strip() 

        # Fechas para datetime
        fecha = campos[1]  # (dd-mes-aaaa)
        fecha_dd_mes_aaaa = campos[1].split("-")
        fecha_dd = int(fecha_dd_mes_aaaa[0])
        fecha_mes = meses[fecha_dd_mes_aaaa[1]]
        fecha_aaaa = int(fecha_dd_mes_aaaa[2])

        fecha_final = datetime.datetime(fecha_aaaa, fecha_mes, fecha_dd)
        fechafinal = fecha_final.strftime("%Y-%m-%d")  # Formato de fecha para el diccionario

        

        hora = campos[2]
        condición_del_cielo = campos[3]
        visibilidad = campos[4]
        temperatura_C = float(campos[5])
        sensación_térmica_C = campos[6]  # — puede venir como el texto No se calcula en vez de un número
        humedad = int(campos[7])
        viento = campos[8]  # dirección y velocidad juntos (por ejemplo Sur  5, o Calma cuando no hay viento)
        presión_hPa = float(campos[9])

        # Apartado de viento
        viento_separado = viento.split()

        if "Calma" in viento_separado:
            direccion = "Calma"
            velocidad = 0.0
        else:
            direccion = " ".join(viento_separado[:-1])
            velocidad = float(viento_separado[-1])

        # Apartado del Sensacion_termina_C
        if "No se calcula" not in sensación_térmica_C:
            sensación_térmica_C = float(sensación_térmica_C)
        else:
            sensación_térmica_C = None

        # Append a todo el dicc
        mi_dicc[ciuad_estación] = {
            "Fecha": fechafinal,
            "Hora": hora,
            "Condicion del cielo": condición_del_cielo,
            "Visibilidad": visibilidad,
            "temperatura(°C)": temperatura_C,
            "Sensación térmica (°C)": sensación_térmica_C,
            "Humedad (%)": humedad,
            "Viento (dirección y viento)": [direccion, velocidad],
            "Presión (hPa)": presión_hPa,
        }

        # FUNCIONES

        #cantidad total de ciudades leídas
        def cant_ciudades_leidas(ciudades:dict) -> list:
            """Devuelve la cantidad total de ciudades leídas."""

            cant = 0
            for ciudad in ciudades.keys():
                cant +=1
            return cant


        # Ciudades con toda la info
        def cantidad_ciudades_completas(observaciones: dict) -> int:
            """Devuelve la cantidad de ciudades sin ningún dato faltante."""
            
            numero= 0
            for valores in observaciones.values():
                if None not in valores.values():
                    numero += 1
            return numero


            #ciudad(es) con la temperatura máxima y con la temperatura mínima;
        def tem_max_min (temperatura:dict) -> str:
            """Devuelve las ciudades con la temperatra máxima y mínima""" 

            ciudad_max =""
            max_temp = -100
            ciudad_min = ""
            min_temp = 100
            for ciudad,informacion in  temperatura.items():
                c = ciudad
                t = informacion["temperatura(°C)"]
                if t > max_temp:
                    ciudad_max = c
                    max_temp = t
                if t < min_temp:
                    ciudad_min = c
                    min_temp = t
            return f"Máxima: {ciudad_max} ({max_temp}°C) | Minima: {ciudad_min} ({min_temp}°C)"

print(tem_max_min(mi_dicc))

